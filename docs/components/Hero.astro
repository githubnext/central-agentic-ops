---
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";
import dispatchFallback from "../assets/control-plane-dispatch-fallback.svg";

const PAGE_TITLE_ID = "_top";

type HeroAction = {
  attrs?: Omit<HTMLAttributes<"a">, "href">;
  icon?: { name?: string; html?: string };
  link: string;
  text: string;
  variant?: "primary" | "secondary" | "minimal";
};
type HeroData = {
  title: string;
  draft?: boolean;
  hero?: {
    title?: string;
    tagline?: string;
    image?: { alt?: string };
    actions?: HeroAction[];
  };
};

const { data } = (Astro.locals as unknown as { starlightRoute: { entry: { data: HeroData } } }).starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const imageAlt = image?.alt || "Central Agentic Ops batches Dependabot and Optimization work, dispatches it to repositories, and consolidates job outcomes.";
---

<div class="hero">
  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
      {data.draft && <aside class="draft-notice">This page is a draft and may contain incomplete content.</aside>}
      {tagline && <div class="tagline" set:html={tagline} />}
    </div>
    {
      actions.length > 0 && (
        <div class="sl-flex actions">
          {actions.map(
            ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
              <a href={href} class:list={["hero-action", variant || "primary", className]} {...attrs}>
                {text}
                {icon?.html ? <Fragment set:html={icon.html} /> : icon?.name === "right-arrow" && <span aria-hidden="true">→</span>}
              </a>
            ),
          )}
        </div>
      )
    }
  </div>

  <figure class="dispatch-scene">
    <Image src={dispatchFallback} alt={imageAlt} loading="eager" decoding="async" style="width: 100%; height: 100%;" />
    <div class="dispatch-motion" aria-hidden="true"></div>
  </figure>
</div>

<script>
  import lottie from "lottie-web/build/player/lottie_light";
  import animationData from "../assets/control-plane-dispatch.animation.mjs";

  const animations = new WeakMap<Element, ReturnType<typeof lottie.loadAnimation>>();
  const observers = new WeakMap<Element, IntersectionObserver>();

  function initializeDispatchAnimations() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    document.querySelectorAll(".dispatch-motion").forEach((container) => {
      if (animations.has(container)) return;

      const animation = lottie.loadAnimation({
        container,
        renderer: "svg",
        loop: true,
        autoplay: false,
        animationData,
        rendererSettings: {
          preserveAspectRatio: "xMidYMid meet",
          progressiveLoad: true,
        },
      });
      const observer = new IntersectionObserver(
        ([entry]) => (entry?.isIntersecting ? animation.play() : animation.pause()),
        { threshold: 0.15 },
      );

      animation.addEventListener("DOMLoaded", () => container.classList.add("is-ready"));
      observer.observe(container);
      animations.set(container, animation);
      observers.set(container, observer);
    });
  }

  function destroyDispatchAnimations() {
    document.querySelectorAll(".dispatch-motion").forEach((container) => {
      observers.get(container)?.disconnect();
      animations.get(container)?.destroy();
      observers.delete(container);
      animations.delete(container);
    });
  }

  initializeDispatchAnimations();
  document.addEventListener("astro:page-load", initializeDispatchAnimations);
  document.addEventListener("astro:before-swap", destroyDispatchAnimations);
</script>

<style>
  @layer starlight.core {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-items: center;
      gap: 2rem;
      padding-block: 2rem 3rem;
    }

    .stack {
      flex-direction: column;
      gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
      text-align: center;
    }

    .copy {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .copy > * {
      max-width: 52ch;
    }

    h1 {
      max-width: 14ch;
      color: var(--sl-color-white);
      font-size: clamp(var(--sl-text-3xl), 6vw, var(--sl-text-6xl));
      font-weight: 650;
      line-height: var(--sl-line-height-headings);
      letter-spacing: 0;
    }

    .tagline {
      color: var(--sl-color-gray-2);
      font-size: clamp(var(--sl-text-base), 2vw, var(--sl-text-xl));
    }

    .draft-notice {
      border-inline-start: 0.25rem solid var(--sl-color-orange);
      padding-inline-start: 1rem;
      color: var(--sl-color-gray-2);
    }

    .actions {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem 2rem;
    }

    .hero-action {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      border: 1px solid transparent;
      border-radius: 999rem;
      padding: 0.4375rem 1.125rem;
      font-size: var(--sl-text-sm);
      font-weight: 600;
      line-height: 1.1875;
      text-decoration: none;
      outline-offset: 0.25rem;
    }

    .hero-action.primary {
      border-color: var(--sl-color-text-accent);
      background: var(--sl-color-text-accent);
      color: var(--sl-color-black);
    }

    .hero-action.secondary {
      border-color: currentColor;
      color: var(--sl-color-white);
    }

    .hero-action.minimal {
      color: var(--sl-color-white);
    }

    .dispatch-scene {
      position: relative;
      width: min(100%, 72rem);
      margin: 0 auto;
      aspect-ratio: 55 / 28;
      isolation: isolate;
    }

    .dispatch-scene > img,
    .dispatch-motion {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    :global([data-has-hero]) .hero .dispatch-scene > img {
      width: 100%;
      height: 100%;
    }

    .dispatch-scene > img {
      object-fit: contain;
    }

    .dispatch-motion {
      z-index: 1;
      opacity: 0;
      transition: opacity 180ms ease-out;
      pointer-events: none;
    }

    .dispatch-motion.is-ready {
      opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
      .dispatch-motion {
        display: none;
      }
    }

    @media (min-width: 64rem) {
      .hero {
        grid-template-columns: minmax(0, 1fr) !important;
        gap: 2rem;
        min-height: auto;
        padding-block: 3rem 4rem;
      }

      .stack {
        max-width: 52rem;
        margin-inline: auto;
        text-align: center;
      }

      .copy {
        align-items: center;
      }

      .actions {
        justify-content: center;
      }
    }
  }
</style>
