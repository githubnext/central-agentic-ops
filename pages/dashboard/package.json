{
  "name": "@central-agentic-ops/dashboard-language-renderer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf ../../public/ymao && mkdir -p ../../public/ymao && tar --exclude='./node_modules' --exclude='./test' --exclude='./test-results' --exclude='./.gitignore' -cf - . | tar -xf - -C ../../public/ymao",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --environment jsdom",
    "test:e2e": "npx playwright test --config=playwright.config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  }
}
