{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "central-agentic-ops-dashboard",
    "title": "Central Agentic Ops Dashboard",
    "description": "Authoritative declarative dashboard document for all specification-defined built-in pages in the presenter prototype.",
    "repository": "githubnext/central-agentic-ops",
    "units": {
      "aic": {
        "name": "AI Credits",
        "symbol": "AIC",
        "significant": 1
      }
    },
    "pages": [
      {
        "id": "overview",
        "kind": "built-in",
        "page": "overview",
        "title": "Overview",
        "icon": "server",
        "class-name": "overview-page",
        "description": "Managed packages, execution health, and items requiring attention.",
        "definition": {
          "data-state": {
            "availability": true,
            "completeness": true,
            "freshness": true
          },
          "sections": [
            {
              "id": "control-plane-health",
              "title": "Control plane health",
              "description": "Current workflow inventory, execution volume, failures, and AI Credit consumption.",
              "layout": "full",
              "views": [
                "overview-control-plane-status",
                "overview-package-aic-utilization",
                "overview-attention-panel",
                "overview-managed-packages"
              ]
            },
            {
              "id": "execution-trends",
              "title": "Execution and value trends",
              "description": "Run conclusions and operational value over time.",
              "layout": "full",
              "views": [
                "overview-run-trend",
                "overview-operational-values"
              ]
            }
          ],
          "views": [
            {
              "id": "overview-control-plane-status",
              "title": "Control plane status",
              "data": {
                "sources": [
                  "repositories",
                  "workflows",
                  "runs",
                  "usage",
                  "overview-status",
                  "overview-vitals",
                  "overview-execution-health"
                ]
              },
              "mark": "element",
              "element": "status-summary",
              "layout": "full"
            },
            {
              "id": "overview-package-aic-utilization",
              "title": "Package AIC utilization",
              "data": {
                "sources": [
                  "workflows",
                  "usage",
                  "overview-package-utilization"
                ]
              },
              "mark": "element",
              "element": "meter-list",
              "layout": "full",
              "description": "Actual AI Credits against summed per-run limits for retained package runs."
            },
            {
              "id": "overview-attention-panel",
              "title": "Needs attention",
              "data": {
                "sources": [
                  "workflows",
                  "runs",
                  "usage",
                  "findings",
                  "overview-attention"
                ]
              },
              "mark": "element",
              "element": "attention-list",
              "layout": "half"
            },
            {
              "id": "overview-managed-packages",
              "title": "Managed packages",
              "data": {
                "sources": [
                  "workflows",
                  "overview-managed-packages"
                ]
              },
              "mark": "element",
              "element": "record-cards",
              "layout": "half"
            },
            {
              "id": "overview-run-trend",
              "disclosure": "supplemental",
              "title": "Run conclusion trend",
              "description": "Run conclusions over time.",
              "data": {
                "source": "runs"
              },
              "mark": "chart",
              "chart": "line",
              "layout": "half",
              "encoding": {
                "x": {
                  "field": "started-at",
                  "type": "temporal",
                  "time-unit": "day"
                },
                "y": {
                  "field": "run",
                  "type": "quantitative",
                  "aggregate": "count"
                },
                "color": {
                  "field": "run-conclusion",
                  "type": "nominal"
                },
                "href": {
                  "field": "run-link",
                  "type": "nominal"
                }
              }
            },
            {
              "id": "overview-operational-values",
              "disclosure": "supplemental",
              "title": "Operational value timeline",
              "description": "Recorded operational value separated by definition.",
              "data": {
                "source": "operational-values"
              },
              "mark": "chart",
              "chart": "line",
              "layout": "half",
              "encoding": {
                "x": {
                  "field": "observed-at",
                  "type": "temporal",
                  "time-unit": "day"
                },
                "y": {
                  "field": "operational-value",
                  "type": "quantitative"
                },
                "color": {
                  "field": "operational-value-definition",
                  "type": "nominal"
                }
              }
            }
          ]
        }
      },
      {
