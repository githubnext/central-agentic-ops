{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "central-agentic-ops-dashboard",
    "title": "Central Agentic Ops Dashboard",
    "description": "Authoritative declarative dashboard document for built-in and custom pages in the presenter prototype.",
    "repository": "githubnext/central-agentic-ops",
    "units": {
      "aic": {
        "name": "AI Credits",
        "symbol": "AIC",
        "significant": 1
      }
    },
    "pages": [
      {
        "id": "overview",
        "kind": "built-in",
        "page": "overview",
        "title": "Overview",
        "icon": "server",
        "class-name": "overview-page",
        "description": "Current operational attention across runtime, controls, value, episodes, cost, and evidence.",
        "definition": {
          "data-state": {
            "availability": true,
            "completeness": true,
            "freshness": true
          },
          "views": [
            {
              "id": "overview-attention-domains",
              "title": "Attention by domain",
              "description": "Ordered by urgency. Each state names only what retained evidence and configured policy can support.",
              "data": {
                "sources": [
                  "repositories",
                  "workflows",
                  "runs",
                  "usage",
                  "outcomes",
                  "findings",
                  "operational-values",
                  "overview-attention-domains"
                ]
              },
              "mark": "element",
              "element": "domain-attention",
              "layout": "full"
            }
          ]
        }
      },
      {
        "id": "cost",
        "kind": "custom",
        "title": "Cost & efficiency",
        "navigation-label": "Cost",
        "icon": "meter",
        "class-name": "cost-page",
        "description": "Measured AI Credit allocation and efficiency evidence for the configured githubnext/central-agentic-ops repository.",
        "filter-bar": {
          "filters": [
            "mode:review",
            "mode:live"
          ],
          "time-range": "All recorded",
          "export": true
        },
        "views": [
          {
            "id": "cost-measured-usage",
            "title": "Measured usage",
            "description": "Observed AI Credit allocation and episode efficiency without inferred budgets or anomalies.",
            "data": {
              "sources": [
                "cost-summary",
                "cost-signals"
              ]
            },
            "mark": "element",
            "element": "metric-signal-summary",
            "layout": "full"
          },
          {
            "id": "cost-by-repository",
            "title": "AI Credit usage by AW repository",
            "description": "Read-only usage reported by AW runs, deduplicated by workflow run.",
            "data": {
              "source": "usage",
              "order-by": [
                {
                  "field": "total-aic",
                  "direction": "desc"
                }
              ]
            },
            "mark": "chart",
            "chart": "pie",
            "layout": "full",
            "encoding": {
              "x": {
                "field": "repository",
                "type": "nominal",
                "title": "Repository"
              },
              "y": {
                "field": "aic",
                "type": "quantitative",
                "aggregate": "sum",
                "as": "total-aic",
                "title": "Total AIC",
                "unit": "aic"
              },
              "href": {
                "field": "repository-link",
                "type": "nominal"
              }
            }
          },
          {
            "id": "cost-evaluation-boundary",
            "title": "Evaluation boundary",
            "data": {
              "sources": [
                "cost-readiness"
              ]
            },
            "mark": "element",
            "element": "readiness-note",
            "layout": "full"
          }
        ]
      },
      {
        "id": "security",
        "kind": "custom",
        "title": "Security & data quality",
        "navigation-label": "Security",
        "icon": "shield",
        "class-name": "security-page",
        "description": "Operational assurance, warning, and telemetry-integrity signals for the configured githubnext/central-agentic-ops repository.",
        "filter-bar": {
          "filters": [
            "mode:review",
            "mode:live"
          ],
          "time-range": "All recorded",
          "export": true
        },
        "sections": [
          {
            "id": "operational-assurance",
            "title": "Needs attention",
            "description": "Execution controls, package integrity, and explicit output warnings.",
            "layout": "full",
            "views": [
              "security-summary",
              "security-signals"
            ]
          }
        ],
        "views": [
          {
            "id": "security-summary",
            "title": "Assurance summary",
            "data": {
              "sources": [
                "security-summary"
              ]
            },
            "mark": "element",
            "element": "summary-grid",
            "layout": "full"
          },
          {
            "id": "security-signals",
            "title": "Assurance signals",
            "description": "No vulnerability feed is retained. These are operational assurance signals, not vulnerability findings; generic run failures and collection gaps remain in their owning domains.",
            "data": {
              "sources": [
                "security-signals"
              ]
            },
            "mark": "element",
            "element": "signal-list",
            "layout": "full"
          }
        ]
      },
      {
        "id": "organizations",
        "kind": "built-in",
        "page": "organizations",
        "title": "Organizations",
