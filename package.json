{
  "name": "central-agentic-ops",
  "private": true,
  "scripts": {
    "docs:dev": "astro dev",
    "docs:build": "astro build",
    "docs:preview": "astro preview",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:load": "node --test tests/load/*.test.mjs",
    "check:svg": "node scripts/check-svg-visual-language.mjs",
    "compile": "gh aw compile --no-emit --no-check-update --schedule-seed githubnext/central-agentic-ops",
    "check": "npm test && npm run test:load && npm run check:svg && npm run compile && npm run docs:build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/starlight": "0.41.7",
    "astro": "7.2.2",
    "lottie-web": "^5.13.0",
    "starlight-theme-galaxy": "0.8.0"
  }
}
