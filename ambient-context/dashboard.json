{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "ambient-context-dashboard",
    "title": "Ambient Context",
    "description": "Track context-curation runs, retained proposals, and matured evidence that accepted changes reduced prompt cost without increasing failures.",
    "repository": "githubnext/gh-aw-cao",
    "pages": [
      {
        "id": "ambient-context-dashboard",
        "kind": "custom",
        "title": "Ambient Context",
        "navigation-label": "Ambient context",
        "description": "Track context-curation runs, retained proposals, and matured evidence that accepted changes reduced prompt cost without increasing failures.",
        "icon": "workflow",
        "views": [
          {
            "id": "ambient-context-runs",
            "title": "Curator runs by conclusion",
            "disclosure": "essential",
            "data": {
              "source": "runs",
              "time": {
                "range": "30d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/ambient-context.md",
                  ".github/workflows/ambient-context-agents-md-curator.md",
                  ".github/workflows/ambient-context-skills-curator.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "pie",
            "encoding": {
              "x": {
                "field": "run-conclusion",
                "type": "nominal"
              },
              "y": {
                "field": "run",
                "type": "quantitative",
                "aggregate": "count"
              }
            }
          },
          {
            "id": "ambient-context-outcomes",
            "title": "Context proposals",
            "description": "Repository-linked AGENTS.md and skill proposals; no-op runs do not create duplicate maintainer work.",
            "disclosure": "essential",
            "data": {
              "source": "outcomes",
              "filters": {
                "package": [
                  "ambient-context"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "empty-message": "No ambient-context proposals were retained.",
            "encoding": {
              "href": {
                "field": "external-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "outcome-title",
                  "type": "nominal",
                  "title": "Proposal"
                },
                {
                  "field": "outcome-state",
                  "type": "nominal",
                  "title": "Disposition",
                  "display": "status"
                },
                {
                  "field": "published-at",
                  "type": "temporal",
                  "title": "Published"
                }
              ]
            }
          },
          {
            "id": "ambient-context-attainment",
            "title": "Accepted attainment evidence",
            "description": "Attainment is evaluated per assigned repository after maturation; missing comparison evidence remains null rather than zero.",
            "disclosure": "essential",
            "data": {
              "source": "operational-values",
              "filters": {
                "workflow": [
                  ".github/workflows/ambient-context-agents-md-curator.md",
                  ".github/workflows/ambient-context-skills-curator.md"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "empty-message": "No ambient-context attainment evidence is available.",
            "encoding": {
              "href": {
                "field": "evidence-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "operational-case",
                  "type": "nominal",
                  "title": "Opportunity"
                },
                {
                  "field": "operational-value",
                  "type": "quantitative",
                  "title": "Attainment"
                },
                {
                  "field": "maturity-status",
                  "type": "nominal",
                  "title": "Maturity",
                  "display": "status"
                },
                {
                  "field": "evidence-cutoff",
                  "type": "temporal",
                  "title": "Evidence cutoff"
                }
              ]
            }
          },
          {
            "id": "ambient-context-value-trend",
            "title": "Operational-value trend",
            "description": "Mean attainment by evaluator definition is diagnostic and does not claim the workflow caused repository outcomes.",
            "disclosure": "essential",
            "data": {
              "source": "operational-values",
              "time": {
                "range": "90d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/ambient-context-agents-md-curator.md",
                  ".github/workflows/ambient-context-skills-curator.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "line",
            "encoding": {
              "x": {
                "field": "observed-at",
                "type": "temporal",
                "time-unit": "day"
              },
              "y": {
                "field": "operational-value",
                "type": "quantitative",
                "aggregate": "mean"
              },
              "color": {
                "field": "operational-value-definition",
                "type": "nominal"
              }
            }
          }
        ]
      }
    ],
    "navigation": [
      {
        "label": "Package operations",
        "pages": [
          "ambient-context-dashboard"
        ]
      }
    ]
  }
}
